rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: verifica se o usuário está autenticado
    function isAuth() {
      return request.auth != null;
    }

    // Helper: busca o perfil do usuário logado
    function getProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    // Helper: verifica cargo
    function hasRole(role) {
      return isAuth() && getProfile().role == role;
    }

    // Helper: contador (só enxerga vendas/notas; não acessa pets, agenda, entregas etc.)
    function isAccountant() {
      return isAuth()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && getProfile().role in ['accountant', 'contador'];
    }

    // Helper: logado e que não é contador
    function isNotAccountant() {
      return isAuth() && !isAccountant();
    }

    // Helper: cargos com acesso administrativo
    function isStaff() {
      return isAuth() && getProfile().role in [
        'desenvolvedor', 'proprietaria', 'gerente', 'colaborador',
        'developer', 'owner', 'manager', 'collaborator'
      ];
    }

    // ---- PERFIS ----
    // Usuário vê e edita apenas o próprio perfil; staff vê todos
    match /profiles/{userId} {
      allow read: if true; // Aberto para permitir resolução de Username/Telefone na tela de login
      allow create: if true; // Permite criação pelo frontend (contorna o delay de propagação do token de auth)
      allow update, delete: if isAuth() && (request.auth.uid == userId || isStaff());
    }

    // ---- PETS ----
    // Staff vê todos; cliente vê apenas os seus
    match /pets/{petId} {
      allow read: if isNotAccountant();
      allow write: if isStaff();
    }

    // ---- AGENDAMENTOS ----
    match /appointments/{apptId} {
      allow read: if isNotAccountant();
      allow create: if isNotAccountant();
      allow update, delete: if isStaff();
    }

    // ---- PRODUTOS / ESTOQUE ----
    match /products/{productId} {
      allow read: if isNotAccountant();
      allow write: if isStaff();
    }

    // ---- ENTREGAS (DELIVERY) ----
    match /deliveries/{deliveryId} {
      allow read: if isNotAccountant();
      allow write: if isStaff();
    }

    // ---- LOGS DE AUDITORIA ----
    // Apenas staff lê; escrita só via Admin SDK
    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow write: if isAuth(); // Permitido para que o logAction via client SDK funcione
    }

    // ---- PRONTUÁRIOS VETERINÁRIOS ----
    match /prontuarios/{docId} {
      allow read: if isNotAccountant();
      allow write: if isStaff();
    }

    // ---- RELATÓRIOS / VENDAS ----
    match /sales/{saleId} {
      allow read: if isStaff() || isAccountant();
      allow write: if isStaff();
    }

    // ---- CONFIGURAÇÕES (dados fiscais etc.) ----
    match /settings/{docId} {
      allow read: if isStaff() || isAccountant();
      allow write: if hasRole('desenvolvedor') || hasRole('proprietaria') || hasRole('developer') || hasRole('owner');
    }

    // ---- PERMISSÕES DE SISTEMA ----
    match /permissions/{permId} {
      allow read: if isAuth();
      allow write: if hasRole('desenvolvedor') || hasRole('proprietaria');
    }

  }
}
