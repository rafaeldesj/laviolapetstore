rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: verifica se o usuário está autenticado
    function isAuth() {
      return request.auth != null;
    }

    // Helper: busca o perfil do usuário logado
    function getProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    // Helper: contador (só enxerga vendas/notas; não acessa pets, agenda, entregas etc.)
    function isAccountant() {
      return isAuth()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && getProfile().role in ['accountant', 'contador'];
    }

    // Helper: logado e que não é contador
    function isNotAccountant() {
      return isAuth() && !isAccountant();
    }

    // Helper: cargos com acesso administrativo
    function isStaff() {
      return isAuth() && getProfile().role in [
        'desenvolvedor', 'proprietaria', 'gerente', 'colaborador',
        'developer', 'owner', 'manager', 'collaborator'
      ];
    }

    // ---- HIERARQUIA DE CARGOS ----
    // Quanto maior o número, maior o poder. Aceita os nomes em português (legado) e em inglês.
    function roleRank(role) {
      return role in ['developer', 'desenvolvedor'] ? 8
           : role in ['owner', 'proprietaria'] ? 6
           : role in ['manager', 'gerente'] ? 4
           : role in ['collaborator', 'colaborador'] ? 2
           : role in ['accountant', 'contador'] ? 1
           : 0;
    }

    function isDeveloper() {
      return isAuth() && roleRank(getProfile().role) == 8;
    }

    function isOwner() {
      return isAuth() && roleRank(getProfile().role) == 6;
    }

    function myRank() {
      return roleRank(getProfile().role);
    }

    // ---- PERFIS ----
    // Usuário vê e edita apenas o próprio perfil; staff vê todos
    // O CARGO (campo role) é protegido:
    //  - qualquer um lê (inclusive o próprio);
    //  - o cadastro público só nasce como cliente, no próprio uid;
    //  - ninguém altera o próprio cargo, exceto o desenvolvedor;
    //  - a equipe só mexe em cargos ABAIXO do seu (e só atribui cargos abaixo do seu).
    match /profiles/{userId} {
      allow read: if true; // Aberto para permitir resolução de Username/Telefone na tela de login

      allow create: if
        (isAuth() && request.auth.uid == userId
          && request.resource.data.get('role', '') in ['client', 'cliente'])
        || isDeveloper()
        || (isStaff() && myRank() > roleRank(request.resource.data.get('role', '')));

      allow update: if isAuth() && (
        isDeveloper()
        || (request.auth.uid == userId
            && request.resource.data.get('role', '') == resource.data.get('role', ''))
        || (isStaff()
            && myRank() > roleRank(resource.data.get('role', ''))
            && myRank() > roleRank(request.resource.data.get('role', '')))
      );

      allow delete: if isAuth() && (
        isDeveloper()
        || (isStaff() && myRank() > roleRank(resource.data.get('role', '')))
      );
    }

    // ---- PETS ----
    // Staff vê todos; cliente vê apenas os seus
    match /pets/{petId} {
      allow read: if isNotAccountant();
      allow write: if isStaff();
    }

    // ---- AGENDAMENTOS ----
    match /appointments/{apptId} {
      allow read: if isNotAccountant();
      allow create: if isNotAccountant();
      allow update, delete: if isStaff();
    }

    // ---- PRODUTOS / ESTOQUE ----
    match /products/{productId} {
      allow read: if isNotAccountant();
      allow write: if isStaff();
    }

    // ---- ENTREGAS (DELIVERY) ----
    match /deliveries/{deliveryId} {
      allow read: if isNotAccountant();
      allow write: if isStaff();
    }

    // ---- LOGS DE AUDITORIA ----
    // Apenas staff lê; escrita só via Admin SDK
    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow write: if isAuth(); // Permitido para que o logAction via client SDK funcione
    }

    // ---- PRONTUÁRIOS VETERINÁRIOS ----
    match /prontuarios/{docId} {
      allow read: if isNotAccountant();
      allow write: if isStaff();
    }

    // ---- RELATÓRIOS / VENDAS ----
    match /sales/{saleId} {
      allow read: if isStaff() || isAccountant();
      allow write: if isStaff();
    }

    // ---- CONFIGURAÇÕES (dados fiscais etc.) ----
    match /settings/{docId} {
      allow read: if isStaff() || isAccountant();
      allow write: if isDeveloper() || isOwner();
    }

    // ---- PERMISSÕES DE SISTEMA ----
    match /permissions/{permId} {
      allow read: if isAuth();
      allow write: if isDeveloper() || isOwner();
    }

  }
}
